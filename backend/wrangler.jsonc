{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "DISPLAY_ROOM",
        "class_name": "DisplayRoom",
      },
    ],
  },
  "exports": {
    "DisplayRoom": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
